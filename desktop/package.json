{
  "name": "khut-desktop",
  "productName": "Khut",
  "version": "1.1.0",
  "private": true,
  "description": "Khut desktop app: runs the bot and its control panel",
  "author": "cankhut",
  "license": "AGPL-3.0-or-later",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "discord.js": "^14.25.1"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.cankhut.khut",
    "productName": "Khut",
    "asar": false,
    "files": ["main.js", "preload.js", "icon.png", "icon.ico"],
    "extraResources": [
      {
        "from": "..",
        "to": "khut",
        "filter": ["src/**", "data/**", "package.json", "LICENSE", "desktop/icon.png"]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "include": "installer.nsh"
    }
  }
}
