{
  "name": "khut-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Khut desktop app: runs the bot and its control panel",
  "author": "cankhut",
  "license": "AGPL-3.0-or-later",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "npm install --prefix .. --omit=dev && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.cankhut.khut",
    "productName": "Khut",
    "files": ["main.js", "preload.js", "icon.png", "icon.ico"],
    "extraResources": [
      {
        "from": "..",
        "to": "khut",
        "filter": ["src/**", "data/**", "node_modules/**", "package.json", "LICENSE", "desktop/icon.png"]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}
